# A NixOS module for baash.
#
# It does three things, because those are the three things a distribution owes
# a shell: install it, list it in `/etc/shells` so `chsh` accepts it, and own
# the system-wide startup file. The last one is the interesting one: baash
# reads the first `$XDG_CONFIG_DIRS/baash/config.sh` it finds *instead of* the
# defaults it carries in the binary (`crates/baash/src/main.rs`), exactly like a
# distribution replacing `/etc/bash.bashrc`. So the generated file runs the copy
# its own package installed first, and only then adds what this module was
# asked for — otherwise enabling the module would silently drop the `ls` alias
# and the completion loader.
#
# The library and `zoxide init bash` are not baked into the store at evaluation
# time: the first is a store path `config/config.sh` sources, the second is one
# line `eval`'d at startup (zoxide printing its script costs about a
# millisecond, and it is the integration zoxide itself documents). `carapace`
# is the third: the shell looks for it on `PATH` when a TAB needs completing, so
# installing it here is the whole integration and no startup line is needed.
{ self }:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.baash;
  inherit (lib)
    mkEnableOption
    mkIf
    mkOption
    optionalString
    types
    ;

  # The same nixpkgs `bash-completion` the flake copies into the Windows
  # binary, so a NixOS machine and an embedded build read one version.
  library = "${pkgs.bash-completion}/share/bash-completion/bash_completion";

  # `config/config.sh` tests these in order: an explicit library, the two
  # Filesystem Hierarchy Standard paths (neither exists on NixOS), then a
  # library mounted in the binary. Naming the store path here is what makes the
  # first one hit.
  completion = ''
    # The completion library, from the store: `config/config.sh` reads
    # `BAASH_BASH_COMPLETION` first and skips anything unreadable, and NixOS
    # has no `/usr/share/bash-completion` for it to fall back to. An
    # environment that already names a library wins, so a shell started with
    # its own choice is not overridden by the system's.
    if [[ -z ''${BAASH_BASH_COMPLETION-} ]]; then
        BAASH_BASH_COMPLETION=${library}
    fi
  '';

  defaults = ''
    # The shell's own defaults, as the package installs them. Sourcing the
    # package's copy rather than repeating it is what keeps the aliases and
    # the completion loader in one place (`config/config.sh`); a system config
    # replaces the built-in one, it does not extend it.
    if [[ -r ${cfg.package}/etc/xdg/baash/config.sh ]]; then
        . ${cfg.package}/etc/xdg/baash/config.sh
    ${optionalString cfg.bashCompletion ''
      elif [[ -r ''${BAASH_BASH_COMPLETION-} ]]; then
          # A package built without the flake's `postInstall` installs no
          # startup file; the completion library is still worth having.
          . "$BAASH_BASH_COMPLETION"
    ''}fi
  '';

  zoxide = ''
    # zoxide: `z`, `zi` and the hook that records every directory for them.
    # The script is printed by the zoxide this module installs, so the two
    # cannot drift; `eval` is the form zoxide documents for bash.
    eval "$(${cfg.zoxide.package}/bin/zoxide init bash)"
  '';

  header = ''
    # Generated by the NixOS module `programs.baash`. Do not edit this file:
    # it is rebuilt from the module's options. Your own settings belong in
    # `~/.config/baash/config.sh`, which runs after this file.
  '';

  # One block per thing that can be on, in the order the shell needs them: the
  # library has to be named before the defaults look for it, and the user's
  # `extraConfig` is last so it can override either.
  startupFile =
    lib.concatStringsSep "\n" (
      [ header ]
      ++ lib.optional cfg.bashCompletion completion
      ++ [ defaults ]
      ++ lib.optional cfg.zoxide.enable zoxide
      ++ lib.optional (cfg.extraConfig != "") cfg.extraConfig
    )
    + "\n";
in
{
  options.programs.baash = {
    enable = mkEnableOption "baash, a POSIX- and bash-compatible interactive shell";

    package = mkOption {
      type = types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.default;
      defaultText = lib.literalExpression "baash.packages.\${pkgs.stdenv.hostPlatform.system}.default";
      description = ''
        The baash package to install. The default is this flake's package for
        the system, which is the commit the module came from; point it at
        another build to track a different one.
      '';
    };

    bashCompletion = mkOption {
      type = types.bool;
      default = true;
      description = ''
        Point baash at the `bash-completion` library in the Nix store, so TAB
        completion for the commands on this machine works out of the box. NixOS
        has no `/usr/share/bash-completion`, so without this the shell has no
        library unless it was built with `embedded-bash-completion`.

        A `BAASH_BASH_COMPLETION` already in the environment is left alone, and
        `BAASH_NO_BASH_COMPLETION=1` still turns completion off inside the
        shell.
      '';
    };

    carapace = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = ''
          Install `carapace`, the completion engine baash asks for the command
          being completed.

          The shell looks for a `carapace` on its `PATH` and prefers it over its
          own generated tables; without one it falls back to those tables and to
          the bash-completion library, so this is the whole integration and
          there is no second switch inside the shell. Installing it here keeps
          completion working for a user whose `PATH` is the system's rather than
          one they assembled by hand.
        '';
      };

      package = lib.mkPackageOption pkgs "carapace" { };
    };

    zoxide = {
      enable = mkEnableOption "zoxide integration (`z` and `zi`, with its directory hook)";

      package = lib.mkPackageOption pkgs "zoxide" { };
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
      description = ''
        Shell code appended to the generated system startup file, after the
        options above and before the user's `~/.config/baash/config.sh`.
      '';
    };
  };

  config = mkIf cfg.enable {
    environment.systemPackages = [
      cfg.package
    ]
    ++ lib.optional cfg.carapace.enable cfg.carapace.package
    ++ lib.optionals cfg.zoxide.enable [ cfg.zoxide.package ];

    # `/etc/shells`: what `chsh` and PAM check before they let this shell be
    # someone's login shell. Being installed is not the same as being allowed.
    environment.shells = [ cfg.package ];

    environment.etc."xdg/baash/config.sh".text = startupFile;
  };
}
